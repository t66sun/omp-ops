{
  "name": "omp-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "dsh-ops ported to omp: honest tool outcomes, read dedup, typed PTC SDK",
  "omp": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "features": {
      "honesty": {
        "default": true,
        "extensions": [
          "./src/extension/honesty.ts"
        ]
      },
      "dedup": {
        "default": true,
        "extensions": [
          "./src/extension/dedup.ts"
        ]
      },
      "ptc": {
        "default": true,
        "extensions": [
          "./src/extension/ptc.ts"
        ]
      }
    }
  }
}
